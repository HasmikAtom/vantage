# Copy this file to `.env` and fill in your values.
# All compose files pick them up automatically.

# ---------------------------------------------------------------------------
# Auth service — required
# ---------------------------------------------------------------------------

# Signs session cookies + state. 32+ random bytes.
#   Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# AES-256-GCM key for the per-user server registry on the auth service.
# Every backend URL + token a user adds is encrypted with this key.
# Rotating invalidates every stored token — users will have to re-enter
# them. Required at startup.
#   Generate: openssl rand -base64 32
VANTAGE_REGISTRY_KEY=

# Single-admin bootstrap: there's no pre-seeded user. First visit shows a
# "create your admin account" page; the first sign-up wins and becomes
# admin. Subsequent sign-ups are gated by an email whitelist the admin
# manages from the dashboard (gear icon → Whitelist) — only emails the
# admin has pre-authorized can register. To start over, delete the auth
# volume:
#   docker volume rm vantage-prod_vantage-auth-data

# Origins permitted to use the auth service (CSRF + cookie scoping).
# Defaults derive from the host's hostname / LAN IP; override only if
# fronting with a custom public URL.
# TRUSTED_ORIGINS=http://localhost:8088,http://localhost:5173

# Passkey relying party — MUST match the hostname the browser sees.
# Defaults to the host's detected hostname. For localhost dev, "localhost"
# works. If you deploy on a LAN IP / public domain, set this explicitly —
# passkey REGISTRATION silently binds to whatever value was active at
# enrollment time, so a wrong RP_ID at first-run means no passkeys until
# you fix it AND re-enrol every key. Get it right on the first deploy.
# AUTH_RP_ID=dashboard.example.com
# AUTH_RP_NAME=Vantage

# SSRF guard: the auth service refuses by default to proxy registered
# backends whose URLs resolve to private / loopback / link-local IPs
# (127/8, RFC1918, 169.254/16, Tailscale 100.64/10, ULA fc00::/7, etc.).
# That protects against operators pointing the proxy at cloud-metadata
# endpoints or other internal services. BUT the bundled single-host
# topology (`docker-compose.prod.yml`) and the prime + outpost
# topology BOTH register backends on private addresses by design — the
# compose files default this var to "1" so those topologies work out of
# the box. Override to "0" only if your deployment exclusively talks
# to backends on public IPs and you want SSRF defence at full strictness.
# AUTH_SSRF_ALLOW_PRIVATE=1

# ---------------------------------------------------------------------------
# OAuth providers (optional — fill what you want enabled)
# ---------------------------------------------------------------------------
# GitHub:  https://github.com/settings/developers
#   Callback: <origin>/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google:  https://console.cloud.google.com/apis/credentials
#   Callback: <origin>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Backend — shared-secret token
#
# Every /api/* request to a `vantage-api` backend must carry the matching
# X-Vantage-Backend-Token header. The auth-service proxy attaches this
# header server-side on every call it forwards to a registered backend;
# the value the user pastes into the "Add server" form must match the
# value the backend was started with.
#
# REQUIRED. The backend refuses to start when this is unset (no more
# "open mode"). Use a fresh random value per backend so a leaked token
# only burns one outpost — the dashboard registers backends one-by-one
# anyway, so per-outpost tokens are no extra work.
#   Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
VANTAGE_BACKEND_TOKEN=

# Per-backend encrypted secret storage. Encrypts whatever the backend
# persists locally (Cloudflare API token saved via the dashboard's
# Settings page, etc.). If unset, the backend falls back to a hostname-
# derived key and warns loudly — fine for first-run, set this for real
# use.
#   Generate: openssl rand -base64 32
VANTAGE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Cloudflare tunnels (optional)
#
# Preferred path is the dashboard's Settings page (per-backend, encrypted
# at rest). These env values act as a fallback when nothing's saved via
# the UI. API token scope: Account -> Cloudflare Tunnel: Read.
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=

# ---------------------------------------------------------------------------
# Host ports + bind interfaces (override Makefile defaults)
# ---------------------------------------------------------------------------

# Frontend (nginx + SPA) — the only port a browser needs.
# VANTAGE_PROD_PORT=8088

# Backend on the dashboard host (docker-compose.prod.yml). Published so
# it can be registered by URL like any other server. Default 0.0.0.0
# (LAN-reachable) and host port 8095 — gated by VANTAGE_BACKEND_TOKEN.
# On boxes with a public NIC, pin VANTAGE_BACKEND_BIND to the LAN / VPN IP.
# VANTAGE_BACKEND_BIND=0.0.0.0
# VANTAGE_BACKEND_PORT=8095

# Backend on a remote host (docker-compose.outpost.yml). Same idea, but
# the bind needs explicit thought because that box's only role is to be
# reached from elsewhere. Defaults: 0.0.0.0 on host port 8095.
# VANTAGE_OUTPOST_BIND=100.64.0.5
# VANTAGE_OUTPOST_PORT=8095

# Dev-mode ports (only used with docker-compose.dev.yml).
# VANTAGE_DEV_FRONTEND_PORT=5173
# VANTAGE_DEV_BACKEND_PORT=8082
# VANTAGE_DEV_AUTH_PORT=3000
