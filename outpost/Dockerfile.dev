# Dev image: same OS as prod runtime so collectors that shell out to smartctl
# and systemctl exercise the same binaries. Uses Debian-based golang to keep
# parity with the Debian runtime stage in Dockerfile.
FROM golang:1.25-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      smartmontools \
      systemd \
      dbus \
      pciutils \
      ca-certificates \
      curl \
      gnupg \
      git \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && chmod a+r /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/debian $(. /etc/os-release; echo $VERSION_CODENAME) stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      docker-ce-cli \
      docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/* \
 && go install github.com/air-verse/air@v1.67.0

WORKDIR /app
ENV CGO_ENABLED=0

ARG VANTAGE_VERSION=dev
ENV VANTAGE_VERSION=$VANTAGE_VERSION

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
