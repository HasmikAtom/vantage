FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

# Vite reads VITE_* env at startup, so the dev server bakes the version into
# the HMR bundle just like the prod build does.
ARG VANTAGE_VERSION=dev
ENV VITE_VANTAGE_VERSION=$VANTAGE_VERSION

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
