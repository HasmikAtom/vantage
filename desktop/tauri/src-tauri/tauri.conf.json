{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage",
  "version": "0.1.0",
  "identifier": "io.vantage.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8088"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vantage",
        "url": "http://localhost:8088",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Vantage dashboard, native window.",
    "longDescription": "Native desktop window for the Vantage system-monitoring dashboard."
  }
}
